{
  "expo": {
    "name": "WordClimb",
    "slug": "wordclimb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wordclimb",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6F4",
    "ios": {
      "bundleIdentifier": "com.marcelgames.wordclimb",
      "appleTeamId": "7H6S64378V",
      "buildNumber": "15",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marcelgames.wordclimb",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6F4",
          "image": "./assets/icon-foreground.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
