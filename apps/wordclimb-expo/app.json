{
  "expo": {
    "name": "WordClimb",
    "slug": "wordclimb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wordclimb",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6F4",
    "ios": {
      "bundleIdentifier": "com.marcelgames.wordclimb",
      "appleTeamId": "7H6S64378V",
      "buildNumber": "20",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marcelgames.wordclimb",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E1F3EB",
          "image": "./assets/splash-wordmark.png",
          "imageWidth": 294
        }
      ],
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-6271901101573718~8478860820",
          "androidAppId": "ca-app-pub-6271901101573718~9736102177",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
