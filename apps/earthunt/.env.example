# Copy to .env.local for local development. Never commit .env.local.

# API base URL — points to the marcel-games-api Gin server
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Devices that should be served AdMob test ads, comma-separated.
#
# The iOS Simulator is a test device automatically, so an ad showing there does
# not prove a real phone will get one: on hardware the same unit asks for a live
# ad, and a new ad unit often answers "no fill" for hours. Listing your device
# here makes it request test ads, which tells the two apart — and it is the only
# sanctioned way to test ads on a device you own.
#
# Format: 32 hex characters, no dashes, e.g. 2077ef9a63d2b398840261c8221a0c9b.
# It is NOT the UDID Xcode shows under Devices and Simulators
# (00008110-0012652E2299801E) — AdMob does not recognise that one, so the device
# keeps asking for live ads and nothing appears. The build rejects a malformed
# value rather than let it fail silently.
#
# The Google SDK prints the right value to the device log on its first ad
# request — run the app from Xcode, open a hint, and look for:
#   <Google> To get test ads on this device, set ... @"THE-ID"
# NEXT_PUBLIC_ADMOB_TEST_DEVICE_IDS=

# Set to 1 to request Google's sample ad units instead of the real ones, even in
# a production build. The one diagnostic that needs no AdMob console access:
# sample units always fill, so if ads appear with this on, the app and native
# setup are fine and the fault is in which units the AdMob account holds.
# Never ship it — sample units earn nothing.
# NEXT_PUBLIC_ADMOB_FORCE_TEST_UNITS=1
