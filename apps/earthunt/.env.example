# Copy to .env.local for local development. Never commit .env.local.

# API base URL — points to the marcel-games-api Gin server
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Devices that should be served AdMob test ads, comma-separated.
#
# The iOS Simulator is a test device automatically, so an ad showing there does
# not prove a real phone will get one: on hardware the same unit asks for a live
# ad, and a new ad unit often answers "no fill" for hours. Listing your device
# here makes it request test ads, which tells the two apart — and it is the only
# sanctioned way to test ads on a device you own.
#
# The identifier is printed to the device log on the first ad request:
#   <Google> To get test ads on this device, set: ... @"THE-ID"
# NEXT_PUBLIC_ADMOB_TEST_DEVICE_IDS=
