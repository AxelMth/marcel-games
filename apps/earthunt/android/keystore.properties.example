# Copy to android/keystore.properties and fill in. That file is gitignored.
#
# The upload key is a credential with no recovery path: if you lose it, you can
# never publish an update to this app on Google Play again (you would have to
# ship a brand-new listing). Back up the .jks file AND these passwords somewhere
# durable — a password manager, not this repo.
#
# Generate the key (choose your own passwords when prompted). The openjdk@21
# formula is keg-only, so keytool is not on PATH — call it via JAVA_HOME:
#
#   export JAVA_HOME=/opt/homebrew/opt/openjdk@21
#   "$JAVA_HOME/bin/keytool" -genkeypair -v \
#     -keystore apps/earthunt/android/upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to apps/earthunt/android/.
storeFile=upload-keystore.jks
storePassword=CHANGEME
keyAlias=upload
keyPassword=CHANGEME
