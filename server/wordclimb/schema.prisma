generator client {
  provider = "go run github.com/steebchen/prisma-client-go"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  deviceUuid String   @unique
  lastLogin  DateTime
  openCount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelHistories LevelHistory[]
  devices        UserDevice[]
}

enum GameMode {
  NORMAL
  RANDOM
  LEVEL_OF_THE_DAY
}

model LevelHistory {
  id           String    @id @default(uuid())
  userId       String
  level        Int
  attempts     Int
  timeSpent    Int
  hintsUsed    Int       @default(0)
  gameMode     GameMode  @default(NORMAL)
  wordLadder   String[]  @default([])

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt

  @@unique([userId, level, gameMode, wordLadder])
}

model LevelOfTheDay {
  id           String   @id @default(uuid())
  date         DateTime @unique
  wordLadder   String[]  @default([])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserDevice {
  id           String  @id @default(uuid())
  userId       String  @unique
  brand        String
  deviceType   String
  isDevice     Boolean
  manufacturer String
  modelName    String
  osName       String
  osVersion    String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}
