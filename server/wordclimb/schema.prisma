generator client {
  provider = "go run github.com/steebchen/prisma-client-go"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  deviceUuid String   @unique
  lastLogin  DateTime
  openCount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelHistories LevelHistory[]
  devices        UserDevice[]
}

enum GameMode {
  NORMAL
  RANDOM
  LEVEL_OF_THE_DAY
}

// The languages the game ships puzzles in. A ladder only works in the language
// the player is reading: handing "back → bend" to a French player is
// unguessable, so every level and every daily is scoped to a locale.
enum Locale {
  EN
  FR
}

// A playable puzzle from the catalogue.
//
// Rows are written by cmd/populate-levels from the catalogue generated by
// apps/wordclimb/scripts/build-catalogue.mjs, which is also what the client
// bundles for offline play. `number` is the 1-based position in the locale's
// catalogue, ordered easiest first, and is what the level counter shown to the
// player refers to.
model Level {
  id         String   @id @default(uuid())
  locale     Locale
  number     Int
  beginWord  String
  endWord    String
  // Intermediate words only, in order from begin to end. The begin and end
  // words live in their own columns rather than being repeated here.
  wordLadder String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, number])
}

model LevelHistory {
  id        String   @id @default(uuid())
  userId    String
  level     Int
  attempts  Int
  timeSpent Int
  hintsUsed Int      @default(0)
  gameMode  GameMode @default(NORMAL)
  // The puzzle that was solved. wordLadder holds the intermediate words only —
  // the ones the player actually had to find, which is what the star rule
  // measures accuracy against — so the two ends are stored alongside it or the
  // history could not say which puzzle an entry was.
  beginWord  String   @default("")
  endWord    String   @default("")
  wordLadder String[] @default([])

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt

  @@unique([userId, level, gameMode, wordLadder])
}

// The puzzle every player of a language gets on a given day.
//
// The whole puzzle is copied here rather than referencing a Level row: once a
// day has been played its ladder must never change, and regenerating the
// catalogue renumbers levels.
model LevelOfTheDay {
  id   String   @id @default(uuid())
  date DateTime
  // Defaulted for the sake of the rows that predate it: before this column
  // existed there was a single, English catalogue, so every stored daily was
  // an English one. Without a default, `prisma db push` refuses to add a
  // required column to a table that already has rows, and the only escape it
  // offers is --force-reset, which drops User and LevelHistory too.
  locale    Locale @default(EN)
  beginWord String @default("")
  endWord    String   @default("")
  // Intermediate words only, same convention as Level.wordLadder.
  wordLadder String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, locale])
}

model UserDevice {
  id           String  @id @default(uuid())
  userId       String  @unique
  brand        String
  deviceType   String
  isDevice     Boolean
  manufacturer String
  modelName    String
  osName       String
  osVersion    String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}
