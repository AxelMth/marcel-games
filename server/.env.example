# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=debug           # "release" in production

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ─── Databases ────────────────────────────────────────────────────────────────
# Each app has its own Postgres database.
DATABASE_URL_EARTHUNT=postgres://user:pass@localhost:5432/earthunt_db?sslmode=disable
DATABASE_URL_WORDCLIMB=postgres://user:pass@localhost:5432/wordclimb_db?sslmode=disable

# ─── Domains (used to route requests to the correct DB) ───────────────────────
EARTHUNT_HOST=earthunt.server.com
WORDCLIMB_HOST=wordclimb.server.com
